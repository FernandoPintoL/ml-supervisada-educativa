# ============================================================
# CONFIGURACIÓN UNIFICADA - API ML (LOCAL + RAILWAY)
# Versión 2.0.0 - api_server_unified.py
# ============================================================

# ============================================================
# AMBIENTE (AUTOMÁTICO)
# ============================================================
# Local:       ENVIRONMENT=development (automático)
# Railway:     ENVIRONMENT=production (detectado)
# Valores:     development | production | railway
# (En la mayoría de casos NO necesitas cambiar esto)
ENVIRONMENT=development

# ============================================================
# DEBUG & LOGGING
# ============================================================
# DEBUG: true en local para reload automático, false en producción
DEBUG=true

# LOG_LEVEL: DEBUG (verbose) | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG

# ============================================================
# PUERTO (AUTOMÁTICO)
# ============================================================
# Local:    Puerto 8001 (automático)
# Railway:  Puerto 8080 (asignado por $PORT)
# Si necesitas override: PORT=8001
# (En la mayoría de casos NO necesitas cambiar)

# ============================================================
# BASE DE DATOS
# ============================================================
# LOCAL
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=educativa
DB_USERNAME=postgres
DB_PASSWORD=1234

# RAILWAY (sobrescribe los anteriores)
# DB_HOST=your-railway-postgres-host.railway.app
# DB_PORT=5432
# DB_DATABASE=railway
# DB_USERNAME=postgres
# DB_PASSWORD=your-railway-password

# ============================================================
# FEATURES - AUTOMÁTICAS POR AMBIENTE
# ============================================================
# En LOCAL (development):        DISABLE automáticamente
# En PRODUCCIÓN (railway):       ENABLE automáticamente
# Puedes forzar con estas variables:

ENABLE_AUTH=false
ENABLE_CACHE=false
ENABLE_AGENT=false
ENABLE_CORS=false

# ENABLE_AUTH=true            # Requiere LARAVEL_APP_KEY
# ENABLE_CACHE=true           # Requiere cache.cache_manager
# ENABLE_AGENT=true           # Requiere agents.recommendation_agent
# ENABLE_CORS=true            # Habilita CORS para todos los orígenes

# ============================================================
# FEATURES - COMPARTIDOS (AMBOS AMBIENTES)
# ============================================================
ENABLE_VOCATIONAL=true
ENABLE_QUESTION_DIFFICULTY=true
ENABLE_BATCH=true

# ============================================================
# AUTENTICACIÓN SANCTUM (SOLO PRODUCCIÓN)
# ============================================================
# Obtén esto de tu aplicación Laravel
LARAVEL_APP_KEY=base64:your-laravel-app-key-here
APP_KEY=base64:your-laravel-app-key-here

# ============================================================
# CONFIGURACIÓN DE HOST
# ============================================================
HOST=0.0.0.0

# ============================================================
# NOTAS IMPORTANTES
# ============================================================
#
# 1. PUERTO AUTOMÁTICO:
#    - Detecta si es Railway por la variable $PORT
#    - Si $PORT=8080 → Railway
#    - Si no existe → Local (usa 8001)
#
# 2. AUTENTICACIÓN:
#    - Local: Deshabilitada por defecto (sin validación)
#    - Railway: Habilitada por defecto (requiere token Sanctum)
#
# 3. CACHÉ:
#    - Local: Deshabilitado por defecto (más rápido)
#    - Railway: Habilitado por defecto (mejor rendimiento)
#
# 4. AGENTE IA:
#    - Local: Deshabilitado por defecto
#    - Railway: Habilitado por defecto
#
# 5. PARA RAILWAY:
#    - DATABASE_URL se asigna automáticamente
#    - PORT se asigna automáticamente
#    - No necesitas cambiar casi nada
#
